# =============================================================================
# KültürRota — .gitignore
# =============================================================================

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
node_modules/

# --- Virtualenv --------------------------------------------------------------
.venv/
venv/
env/
ENV/

# --- IDE / Editor ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# --- Test / Coverage ---------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Env / Secrets -----------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# --- Docker / DB -------------------------------------------------------------
postgres_data/
redis_data/

# --- Logs --------------------------------------------------------------------
*.log
logs/

# --- ETL Bronze Lake (PRD §8.3) ---------------------------------------------
# Ham snapshot dosyaları (S3'e taşınana kadar yerel filesystem'de tutulur).
etl/bronze/source=*/
etl_smoke.log
shell_test.txt
etl_import_check.txt
