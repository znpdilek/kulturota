# =============================================================================
# KültürRota — Geliştirme Ortamı Değişkenleri (örnek)
# Bu dosyayı `.env` olarak kopyalayıp lokal değerlerinizi girin.
# =============================================================================

# --- Genel -------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kulturrota
POSTGRES_USER=kulturrota
POSTGRES_PASSWORD=kulturrota_dev

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# --- JWT (PRD §17.2) ---------------------------------------------------------
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Otonom AI Karar Katmanı (PRD §9) ----------------------------------------
# Birincil sağlayıcı: Google AI Studio — Gemini Flash (PRD §9.2).
# Ücretsiz API anahtarınızı şuradan alabilirsiniz:
#   https://aistudio.google.com/app/apikey
# Mentor direktifi gereği SADECE free-tier kullanılır (15 RPM, 1500 req/gün).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Rate-limit ayarları (PRD §9.3). Genellikle değiştirmeye gerek yoktur.
# AI_RATE_LIMIT_SEC=4.5
# AI_DAILY_QUOTA=1400
# AI_RATE_LIMIT_BACKOFF_SEC=60
# AI_CONFIDENCE_THRESHOLD=0.85
# AI_MAX_RETRY_COUNT=3
# AI_BATCH_SIZE=200

# --- Medya / S3 / MinIO (PRD §13 + §16 — Adım 6) -----------------------------
# Geliştirmede MinIO (S3 uyumlu) kullanılır; üretimde gerçek AWS S3'e
# geçildiğinde sadece S3_ENDPOINT_URL boş bırakılır ve gerçek key/secret girilir.
#
# MinIO web console:    http://localhost:9001
# MinIO S3 API:         http://localhost:9000
#
# `docker compose up -d minio minio-init` komutu çalıştığında bucket otomatik
# oluşturulur ve anonim okuma izniyle (download) açılır.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=kulturrota
S3_SECRET_KEY=kulturrota_dev_secret
S3_BUCKET_PHOTOS=kulturrota-photos
# MinIO için True, AWS S3 prod için False (virtual-host-style).
S3_USE_PATH_STYLE=true
# Boş bırakılırsa endpoint URL'ine fallback eder. Prod'da CDN base URL'i yazın.
S3_PUBLIC_BASE_URL=http://localhost:9000

# docker-compose içindeki MinIO port mapping override'ları (opsiyonel)
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# --- Upload Güvenliği (PRD §17.4) --------------------------------------------
# Maksimum dosya boyutu (bayt). Varsayılan 5 MB.
# MEDIA_MAX_BYTES=5242880
# Sadece .jpg ve .png; magic-byte ile çapraz kontrol yapılır.
# MEDIA_ALLOWED_MIME=["image/jpeg","image/png"]
# PRD §17.3 — EXIF GPS verisi yüklemeden önce temizlenir (KVKK).
# MEDIA_STRIP_EXIF=true
# Konum doğrulaması için GPS *sunucu içinde* okunsun mu? DB'ye yazılmaz.
# MEDIA_EXTRACT_GPS_FOR_VERIFICATION=true
